# Скопировать в .env и заполнить. .env в git не попадает.

# Telegram: токен бота от @BotFather. Им же проверяется подпись входа.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Секрет для подписи JWT сессии. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me

# Разрешённые источники для CORS (через запятую)
CORS_ORIGINS=http://localhost:3000

# Публичный адрес фронтенда
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
